#!/bin/bash
# Week 10 homework: run the free gates (no model calls) on every commit.
# Install with:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
root="$(git rev-parse --show-toplevel)"
py="$root/.venv/bin/python"
if [ "$(uname -s)" != "Linux" ] || [ ! -x "$py" ]; then
    echo "pre-commit: free gates skipped (run git from WSL to use the venv)"
    exit 0
fi
cd "$root/labs/week10/starter" || exit 1
start=$(date +%s.%N)
"$py" -m pytest -q -p no:cacheprovider -m "not judged" || {
    echo "pre-commit: a free gate failed, commit stopped"; exit 1; }
end=$(date +%s.%N)
echo "pre-commit: free gates passed in $(echo "$end - $start" | bc) s"
